# ─── Servidor ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Seguridad ───────────────────────────────────────────────
# OBLIGATORIO en producción (el servidor no arranca sin esto)
SESSION_SECRET=cambiar_por_string_aleatorio_seguro_32chars
# Contraseña inicial del usuario admin (si se omite, se genera una y se muestra UNA vez en el log)
ADMIN_PASSWORD=
# Orígenes permitidos para el panel, separados por coma (vacío = solo mismo origen)
CORS_ORIGINS=

# ─── Base de datos ───────────────────────────────────────────
# Vacío = SQLite local. Railway: DATABASE_URL de PostgreSQL
DATABASE_URL=
# Ruta del archivo SQLite local (opcional)
DB_PATH=

# ─── WhatsApp ────────────────────────────────────────────────
# Carpeta de la sesión de Baileys (en Railway: volumen, p.ej. /data/auth). NUNCA versionar.
WA_AUTH_PATH=./auth
# Zona horaria del negocio: horarios de atención, IA y horario silencioso anti-ban
APP_TZ=America/Argentina/Buenos_Aires

# ─── App ─────────────────────────────────────────────────────
APP_NAME=Mi CRM
APP_URL=http://localhost:3000
